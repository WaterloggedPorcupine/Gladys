GLADYS_ENVIRONMENT=development
GLADYS_DATABASE__URL=postgresql+asyncpg://gladys:gladys@localhost:5432/gladys
GLADYS_REDIS__URL=redis://localhost:6379/0
GLADYS_LLM__API_KEY=
GLADYS_LLM__GENERATOR_MODEL=claude-opus-5-5
GLADYS_LLM__GENERATOR_EFFORT=high
GLADYS_AGENT__MAX_ITERATIONS=12
GLADYS_AGENT__MAX_TOTAL_TOKENS=100000
GLADYS_AGENT__MAX_COST_USD=10
GLADYS_SANDBOX__URL=http://localhost:8001
GLADYS_AUTH__REQUIRE_DISTINCT_APPROVER=true
GLADYS_OBSERVABILITY__LOG_LEVEL=INFO
